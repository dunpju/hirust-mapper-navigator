<?xml version="1.0" encoding="UTF-8"?>
<!--
  手动验证样例 mapper XML。
  验证点(XML → Rust):
  - Ctrl+Click namespace 值 / <mapper> 行 gutter 图标 → privilege_project_dao.rs 的 #[dao] 属性
  - Ctrl+Click 各语句 id 值 / 语句行 gutter 图标 → 对应 #[mapper_*] 方法
-->
<mapper namespace="crate::app::dao::privilege_project_dao">

    <select id="get_all" resultType="PrivilegeProject">
        SELECT * FROM privilege_project
    </select>

    <select id="list" resultType="PrivilegeProject">
        SELECT * FROM privilege_project LIMIT 10
    </select>

    <insert id="create">
        INSERT INTO privilege_project (name) VALUES (#{name})
    </insert>

    <update id="update_by_id">
        UPDATE privilege_project SET name = #{name} WHERE id = #{id}
    </update>

    <delete id="remove">
        DELETE FROM privilege_project WHERE id = #{id}
    </delete>

    <insert id="create2">
        INSERT INTO privilege_project (id, name)
        VALUES (#{id}, #{name})
    </insert>

    <select id="get_by_id">
        SELECT * FROM privilege_project WHERE id = #{id}
    </select>
</mapper>
